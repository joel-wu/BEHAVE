@@ -62,2 +65,26 @@
 
+    void handle(const CallExpression& expr) {
+        if (modified)
+            return;
+        visitDefault(expr);
+        if (!inspectCalls || expr.isSystemCall() || expr.thisClass())
+            return;
+        const auto* callee = std::get<const SubroutineSymbol*>(expr.subroutine);
+        const auto args = expr.arguments();
+        const auto formals = callee->getArguments();
+        for (size_t i = 0; i < args.size(); ++i) {
+            if (formals[i]->direction == ArgumentDirection::In)
+                continue;
+            auto arg = args[i];
+            if (auto assign = arg->as_if<AssignmentExpression>();
+                assign && assign->isLValueArg())
+                arg = &assign->left();
+            checkTarget(*arg);
+            if (modified)
+                return;
+        }
+        if (!modified && visited.insert(callee).second)
+            callee->getBody().visit(*this);
+    }
