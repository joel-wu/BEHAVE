+class GraphLoopReportTest final : public V3Graph {
+public:
+    string loopsVertexCb(V3GraphVertex* vtxp) override { return vtxp->name() + "\n"; }
+};
+
+static void graphLoopReportSelfTest() {
+    uint32_t seed = 937;
+    const auto random = [&]() {
+        seed = seed * 1664525U + 1013904223U;
+        return seed;
+    };
+    const V3EdgeFuncP filters[] = {
+        V3GraphEdge::followAlwaysTrue,
+        [](const V3GraphEdge* edgep) { return edgep->weight() > 1; }
+    };
+    for (unsigned trial = 0; trial < 1000; ++trial) {
+        GraphLoopReportTest graph;
+        std::vector<V3GraphVertex*> vertices;
+        const unsigned count = 2 + random() % 32;
+        for (unsigned i = 0; i < count; ++i) {
+            auto* const vp = new V3GraphTestVertex{&graph, std::to_string(i)};
+            vp->user(17);
+            vertices.push_back(vp);
+        }
+        for (unsigned i = 0; i < count * 3; ++i) {
+            const unsigned a = random() % count;
+            const unsigned b = random() % count;
+            new V3GraphEdge{&graph, vertices[a], vertices[b], int(random() % 3)};
+        }
+        for (V3EdgeFuncP filter : filters) {
+            for (V3GraphVertex* startp : vertices) {
+                std::unordered_set<V3GraphVertex*> active, completed;
+                std::vector<V3GraphVertex*> path;
+                const auto walk = [&](auto&& self, V3GraphVertex* vp) -> bool {
+                    path.push_back(vp);
+                    if (active.count(vp)) return true;
+                    if (!completed.count(vp)) {
+                        active.insert(vp);
+                        for (const V3GraphEdge& edge : vp->outEdges()) {
+                            if (edge.weight() && filter(&edge) && self(self, edge.top())) return true;
+                        }
+                        active.erase(vp);
+                        completed.insert(vp);
+                    }
+                    path.pop_back();
+                    return false;
+                };
+                walk(walk, startp);
+                std::string expected;
+                for (V3GraphVertex* vp : path) expected += graph.loopsVertexCb(vp);
+                UASSERT(graph.reportLoops(filter, startp) == expected,
+                        "Loop diagnostic differs from independent DFS");
+                for (V3GraphVertex* vp : vertices) {
+                    UASSERT(vp->user() == 17, "Loop reporting changed graph user state");
+                }
+            }
+        }
+    }
+    // Numerous unrelated components must not require a full clear per report.
+    GraphLoopReportTest graph;
+    std::vector<V3GraphVertex*> vertices;
+    for (unsigned i = 0; i < 16384; ++i) {
+        auto* const vp = new V3GraphTestVertex{&graph, std::to_string(i)};
+        new V3GraphEdge{&graph, vp, vp, 1};
+        vertices.push_back(vp);
+    }
+    for (V3GraphVertex* vp : vertices) {
+        const auto entry = graph.loopsVertexCb(vp);
+        UASSERT(graph.reportLoops(V3GraphEdge::followAlwaysTrue, vp) == entry + entry,
+                "A self-loop must retain both endpoints");
+    }
+}
