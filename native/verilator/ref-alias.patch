+// Fixed storage can be substituted at an inline call site. Array indices must
+// be captured on entry, but the selected storage remains a live alias. Object
+// handles and dynamic containers continue through the non-inline path.
+static bool inlineRefStorage(const AstNodeExpr* nodep) {
+    if (VN_IS(nodep, VarRef)) return true;
+    if (const AstArraySel* const selp = VN_CAST(nodep, ArraySel)) {
+        return VN_IS(selp->fromp()->dtypep()->skipRefp(), UnpackArrayDType)
+               && inlineRefStorage(selp->fromp());
+    }
+    if (const AstStructSel* const selp = VN_CAST(nodep, StructSel)) {
+        return inlineRefStorage(selp->fromp());
+    }
+    return false;
+}
