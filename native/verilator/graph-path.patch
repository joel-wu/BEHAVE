+// Compare the actual path checker and deletion order with an independent
+// exhaustive walk, including parallel edges and both high-degree directions.
+static bool graphAlternatePath(const V3GraphEdge* excludedp) {
+    const V3GraphVertex* const targetp = excludedp->top();
+    std::vector<const V3GraphVertex*> pending{excludedp->fromp()};
+    std::unordered_set<const V3GraphVertex*> seen;
+    while (!pending.empty()) {
+        const V3GraphVertex* const vertexp = pending.back();
+        pending.pop_back();
+        if (!seen.insert(vertexp).second) continue;
+        for (const V3GraphEdge& edge : vertexp->outEdges()) {
+            if (&edge == excludedp) continue;
+            if (edge.top() == targetp) return true;
+            pending.push_back(edge.top());
+        }
+    }
+    return false;
+}
+
+static void graphPathCheckSelfTest() {
+    uint32_t seed = 754;
+    const auto random = [&]() {
+        seed = seed * 1664525U + 1013904223U;
+        return seed;
+    };
+    for (unsigned trial = 0; trial < 1000; ++trial) {
+        V3Graph graph;
+        std::vector<V3GraphVertex*> vertices;
+        const unsigned size = 2 + random() % 48;
+        for (unsigned i = 0; i < size; ++i) vertices.push_back(new V3GraphVertex{&graph});
+        for (unsigned i = 0; i < size * 4; ++i) {
+            const unsigned a = random() % size;
+            const unsigned b = random() % size;
+            if (a != b) {
+                new V3GraphEdge{&graph, vertices[std::min(a, b)], vertices[std::max(a, b)],
+                                1};
+            }
+        }
+        GraphPathChecker checker{&graph};
+        for (V3GraphVertex& vertex : graph.vertices()) {
+            for (V3GraphEdge* const edgep : vertex.outEdges().unlinkable()) {
+                const bool expected = graphAlternatePath(edgep);
+                UASSERT(checker.isTransitiveEdge(edgep) == expected,
+                            "Transitive-edge query differs from exhaustive walk");
+                if (expected) edgep->unlinkDelete();
+            }
+        }
+    }
+    for (bool reverse : {false, true}) {
+        V3Graph graph;
+        auto* const centerp = new V3GraphVertex{&graph};
+        for (unsigned i = 0; i < 16384; ++i) {
